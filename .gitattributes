# 统一换行符：文本文件自动转换为 LF
* text=auto

# 明确指定文件类型
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# 二进制文件不转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.svg       binary
*.mp4       binary
*.mkv       binary
*.ttf       binary
*.woff      binary
*.woff2     binary
